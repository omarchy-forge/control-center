#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

jq -e . "$repo_root/manifest.json" >/dev/null
bash -n "$repo_root/demo/run"
bash -n "$repo_root/tests/runtime"

for required in \
  'references/omaforge-final-logo-300-app-icon.png' \
  'text: "Process Center"' \
  'text: "PROCESSES"' \
  'brandOrange' \
  'brandCyan'; do
  grep -Fq "$required" "$repo_root/Panel.qml" || {
    echo "Panel.qml is missing visual-fidelity contract: $required" >&2
    exit 1
  }
done

for filter in 'label: "All"' 'label: "Apps"' 'label: "System"' 'label: "Servers"' 'label: "Ports"'; do
  grep -Fq "$filter" "$repo_root/Panel.qml" || { echo "missing process filter: $filter" >&2; exit 1; }
done

for refresh_contract in \
  'if (!hasSnapshot) status = "loading"' \
  'if (listProcess.running) return' \
  'showing the last successful snapshot'; do
  grep -Fq "$refresh_contract" "$repo_root/services/ProjectService.qml" || {
    echo "ProjectService.qml is missing non-flickering refresh contract: $refresh_contract" >&2
    exit 1
  }
done

if command -v qmllint >/dev/null 2>&1; then
  lint_output=$(qmllint "$repo_root/Panel.qml" 2>&1 || true)
elif [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  lint_output=$(/usr/lib/qt6/bin/qmllint "$repo_root/Panel.qml" 2>&1 || true)
else
  lint_output=""
fi
if grep -Fq "Syntax error" <<<"$lint_output"; then
  printf '%s\n' "$lint_output" >&2
  exit 1
fi

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$repo_root"
else
  echo "omarchy is unavailable; skipped official plugin validation" >&2
fi

if find "$repo_root" -name .git -prune -o -type l -print -quit | grep -q .; then
  echo "symlinks are not allowed in the plugin project" >&2
  exit 1
fi

echo "plugin checks passed"
